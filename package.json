{
  "name": "mybatis-booster",
  "displayName": "Mybatis Booster",
  "description": "A MyBatis Mapper Helper for VSCode",
  "publisher": "JUNGHO",
  "icon": "logo.webp",
  "license": "Apache-2.0",
  "main": "./out/extension.js",
  "version": "1.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungho-dev/mybatis-booster.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mybatis",
    "mapper",
    "sql",
    "java",
    "xml",
    "log"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:xml",
    "onLanguage:sql"
  ],
  "contributes": {
    "outputChannels": [
      "Mybatis-Booster"
    ],
    "snippets": [
      {
        "language": "xml",
        "path": "./snippets/mybatis.json"
      }
    ],
    "commands": [
      {
        "command": "Mybatis-Booster.gotoxml",
        "title": "Go to XML Mapper",
        "category": "Mybatis-Booster",
        "icon": "$(references)"
      },
      {
        "command": "Mybatis-Booster.gotojava",
        "title": "Go to Java Mapper",
        "category": "Mybatis-Booster",
        "icon": "$(references)"
      },
      {
        "command": "Mybatis-Booster.refreshmapper",
        "title": "Refresh Mappers",
        "category": "Mybatis-Booster",
        "icon": "$(refresh)"
      },
      {
        "command": "Mybatis-Booster.formatlog",
        "title": "Convert MyBatis Log to SQL",
        "category": "Mybatis-Booster",
        "icon": "$(output)"
      },
      {
        "command": "Mybatis-Booster.previewsql",
        "title": "Preview SQL from Statement",
        "category": "Mybatis-Booster",
        "icon": "$(eye)"
      },
      {
        "command": "Mybatis-Booster.gotologstatement",
        "title": "Go to Statement from Log",
        "category": "Mybatis-Booster",
        "icon": "$(search)"
      },
      {
        "command": "Mybatis-Booster.openLogOutput",
        "title": "Open Log Output",
        "category": "Mybatis-Booster"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "Mybatis-Booster.gotoxml",
          "when": "resourceLangId == java",
          "group": "navigation@1"
        },
        {
          "command": "Mybatis-Booster.gotojava",
          "when": "resourceLangId == xml",
          "group": "navigation@1"
        },
        {
          "command": "Mybatis-Booster.formatlog",
          "when": "editorHasSelection",
          "group": "navigation@2"
        },
        {
          "command": "Mybatis-Booster.previewsql",
          "when": "resourceLangId == xml",
          "group": "navigation@3"
        },
        {
          "command": "Mybatis-Booster.gotologstatement",
          "when": "editorHasSelection",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Mybatis-Booster",
      "properties": {
        "Mybatis-Booster.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "hint",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "Mybatis-Booster.sqlKeywordColor": {
          "type": "string",
          "default": "#c586c0",
          "description": "Highlight color for SQL keywords in MyBatis XML mapper and SQL files"
        },
        "Mybatis-Booster.sqlDangerColor": {
          "type": "string",
          "default": "#F44747",
          "description": "Highlight color for destructive SQL keywords"
        },
        "Mybatis-Booster.sqlStringColor": {
          "type": "string",
          "default": "#f4d4ae",
          "description": "Highlight color for SQL string literals"
        },
        "Mybatis-Booster.sqlNumberColor": {
          "type": "string",
          "default": "#00FF00",
          "description": "Highlight color for SQL numeric literals"
        },
        "Mybatis-Booster.sqlCommentColor": {
          "type": "string",
          "default": "#ffff00",
          "description": "Highlight color for SQL-native comments"
        },
        "Mybatis-Booster.sqlInvalidCommentColor": {
          "type": "string",
          "default": "#5d9b5d",
          "description": "Highlight color for comments that do not belong to the current document language"
        },
        "Mybatis-Booster.sqlHighlightEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SQL syntax highlighting in MyBatis XML mapper and SQL files"
        },
        "Mybatis-Booster.maxDocumentLength": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Skip syntax highlighting above this document length. Use 0 for no limit."
        },
        "Mybatis-Booster.codeLensEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Java and XML mapper navigation CodeLens"
        },
        "Mybatis-Booster.languageFeaturesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable MyBatis go-to-definition, hover, XML completion, and document symbols"
        },
        "Mybatis-Booster.searchExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/target/**",
            "**/build/**",
            "**/bin/**",
            "**/out/**",
            "**/dist/**",
            "**/.git/**"
          ],
          "description": "Glob patterns excluded from XML mapper scanning"
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.110.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "git": "bun run ~/.bootstrap/bootstrap-sync.ts --git",
    "swc": "bun run ~/.bootstrap/bootstrap-sync.ts --swc",
    "sync": "bun run ~/.bootstrap/bootstrap-sync.ts --sync",
    "tools": "bun run ~/.bootstrap/bootstrap-sync.ts --tools"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "1.110.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "mocha": "^11.8.0",
    "ts-morph": "^28.0.0",
    "ts-prune": "^0.10.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  }
}
