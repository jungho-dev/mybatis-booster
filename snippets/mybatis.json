{
  "mybatis mapper": {
    "prefix": "mapper",
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"https://mybatis.org/dtd/mybatis-3-mapper.dtd\">",
      "<mapper namespace=\"$1\">",
      "",
      "\t$0",
      "",
      "</mapper>"
    ],
    "description": "Create a MyBatis XML mapper skeleton"
  },
  "mybatis resultMap": {
    "prefix": "resultMap",
    "body": [
      "<resultMap id=\"$1\" type=\"$2\">",
      "\t<id column=\"$3\" property=\"$4\"/>",
      "\t<result column=\"$5\" property=\"$6\"/>",
      "</resultMap>"
    ],
    "description": "Create a resultMap element"
  },
  "mybatis select": {
    "prefix": "select",
    "body": [
      "<select id=\"$1\" resultType=\"$2\">",
      "\t$0",
      "</select>"
    ],
    "description": "Create a select statement"
  },
  "mybatis insert": {
    "prefix": "insert",
    "body": [
      "<insert id=\"$1\" parameterType=\"$2\">",
      "\t$0",
      "</insert>"
    ],
    "description": "Create an insert statement"
  },
  "mybatis update": {
    "prefix": "update",
    "body": [
      "<update id=\"$1\" parameterType=\"$2\">",
      "\t$0",
      "</update>"
    ],
    "description": "Create an update statement"
  },
  "mybatis delete": {
    "prefix": "delete",
    "body": [
      "<delete id=\"$1\" parameterType=\"$2\">",
      "\t$0",
      "</delete>"
    ],
    "description": "Create a delete statement"
  },
  "mybatis sql fragment": {
    "prefix": "sql",
    "body": [
      "<sql id=\"$1\">",
      "\t$0",
      "</sql>"
    ],
    "description": "Create a reusable sql fragment"
  },
  "mybatis include": {
    "prefix": "include",
    "body": [
      "<include refid=\"$1\"/>"
    ],
    "description": "Include a sql fragment"
  },
  "mybatis if": {
    "prefix": "if",
    "body": [
      "<if test=\"$1\">",
      "\t$0",
      "</if>"
    ],
    "description": "Create an if branch"
  },
  "mybatis where": {
    "prefix": "where",
    "body": [
      "<where>",
      "\t$0",
      "</where>"
    ],
    "description": "Create a where wrapper"
  },
  "mybatis foreach": {
    "prefix": "foreach",
    "body": [
      "<foreach collection=\"$1\" item=\"$2\" separator=\",\" open=\"(\" close=\")\">",
      "\t#{$2}",
      "</foreach>"
    ],
    "description": "Create a foreach loop"
  },
  "mybatis CDATA": {
    "prefix": "CD",
    "body": [
      "<![CDATA[$1]]>"
    ],
    "description": "Create a CDATA section"
  },
  "mybatis choose": {
    "prefix": "choose",
    "body": [
      "<choose>",
      "\t<when test=\"$1\">",
      "\t\t$2",
      "\t</when>",
      "\t<otherwise>",
      "\t\t$0",
      "\t</otherwise>",
      "</choose>"
    ],
    "description": "Create a choose/when/otherwise branch"
  },
  "mybatis set": {
    "prefix": "set",
    "body": [
      "<set>",
      "\t<if test=\"$1 != null\">$2 = #{$1},</if>",
      "\t$0",
      "</set>"
    ],
    "description": "Create a set wrapper for dynamic updates"
  },
  "mybatis trim": {
    "prefix": "trim",
    "body": [
      "<trim prefix=\"$1\" prefixOverrides=\"AND |OR \">",
      "\t$0",
      "</trim>"
    ],
    "description": "Create a trim wrapper"
  },
  "mybatis bind": {
    "prefix": "bind",
    "body": [
      "<bind name=\"$1\" value=\"'%' + $2 + '%'\"/>"
    ],
    "description": "Create a bind variable (e.g. LIKE pattern)"
  },
  "mybatis selectKey": {
    "prefix": "selectKey",
    "body": [
      "<selectKey keyProperty=\"$1\" resultType=\"long\" order=\"${2|BEFORE,AFTER|}\">",
      "\tSELECT LAST_INSERT_ID()",
      "</selectKey>"
    ],
    "description": "Create a selectKey for generated keys"
  },
  "mybatis paging": {
    "prefix": "paging",
    "body": [
      "LIMIT #{${1:size}} OFFSET #{${2:offset}}"
    ],
    "description": "Create a LIMIT/OFFSET paging clause"
  },
  "mybatis where if": {
    "prefix": "whereif",
    "body": [
      "<where>",
      "\t<if test=\"$1 != null and $1 != ''\">",
      "\t\tAND $2 = #{$1}",
      "\t</if>",
      "</where>"
    ],
    "description": "Create a where wrapper with a conditional filter"
  },
  "mybatis insert batch": {
    "prefix": "insertBatch",
    "body": [
      "<insert id=\"$1\" parameterType=\"java.util.List\">",
      "\tINSERT INTO $2 ($3)",
      "\tVALUES",
      "\t<foreach collection=\"list\" item=\"item\" separator=\",\">",
      "\t\t(#{item.$4})",
      "\t</foreach>",
      "</insert>"
    ],
    "description": "Create a batch insert with foreach VALUES"
  },
  "mybatis insert generated key": {
    "prefix": "insertKey",
    "body": [
      "<insert id=\"$1\" parameterType=\"$2\" useGeneratedKeys=\"true\" keyProperty=\"${3:id}\">",
      "\t$0",
      "</insert>"
    ],
    "description": "Create an insert that returns the generated key"
  },
  "mybatis association": {
    "prefix": "association",
    "body": [
      "<association property=\"$1\" javaType=\"$2\">",
      "\t<id column=\"$3\" property=\"$4\"/>",
      "\t<result column=\"$5\" property=\"$6\"/>",
      "</association>"
    ],
    "description": "Create a resultMap association (has-one)"
  },
  "mybatis collection": {
    "prefix": "collection",
    "body": [
      "<collection property=\"$1\" ofType=\"$2\">",
      "\t<id column=\"$3\" property=\"$4\"/>",
      "\t<result column=\"$5\" property=\"$6\"/>",
      "</collection>"
    ],
    "description": "Create a resultMap collection (has-many)"
  }
}
